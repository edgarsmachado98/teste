# ---------- Segurança ----------
# Chave compartilhada entre backend e detector
DETECTOR_API_KEY=troque-esta-chave
POSTGRES_PASSWORD=troque-esta-senha

# ---------- Geral ----------
PUBLIC_URL=http://localhost:8000
# Dias que as imagens de evidência ficam guardadas (LGPD)
RETENTION_DAYS=30
# Dias que o registro da ocorrência (sem imagem) fica guardado, para indicadores históricos
EVENT_RETENTION_DAYS=730
# Fuso horário da planta e turnos (usados nos indicadores e mensagens)
TIMEZONE=America/Sao_Paulo
SHIFTS=Turno A=06-14,Turno B=14-22,Turno C=22-06
# Duração da sessão de login (horas)
SESSION_HOURS=12
# Câmera sem imagem por mais que isto (segundos) gera alerta de "sem sinal"
CAMERA_OFFLINE_AFTER=60

# Nome da empresa/unidade (cabeçalho do relatório)
COMPANY_NAME=

# ---------- Relatório automático por e-mail ----------
# mensal (dia 1, mês anterior) | semanal (segunda-feira, semana anterior) | desligado
REPORT_FREQUENCY=mensal
REPORT_HOUR=7
# Vazio = usa ALERT_EMAILS
REPORT_EMAILS=

# ---------- Backup (SQLite) ----------
BACKUP_DIR=./data/backups
BACKUP_HOUR=2
BACKUP_KEEP=14
# Cópia extra de cada backup, ex.: pasta de rede \\servidor\backups\vigia
BACKUP_COPY_DIR=

# ---------- HTTPS ----------
# Gere com "python vigia.py --gerar-certificado" (usa certs/ automaticamente) ou informe os seus:
# SSL_CERTFILE=C:\certificados\vigia.crt
# SSL_KEYFILE=C:\certificados\vigia.key
# SSL_CAFILE=C:\certificados\ca.crt

# ---------- Detector ----------
# Um ou mais modelos separados por vírgula. yolov8n.pt detecta pessoas (é baixado automaticamente).
# Para EPI e fogo/fumaça, coloque modelos treinados na pasta ./modelos
MODEL_PATHS=yolov8n.pt
# MODEL_PATHS=yolov8n.pt,modelos/epi.pt,modelos/fogo.pt
ANALYSIS_FPS=3
# Clipe de cada ocorrência: segundos antes e depois do desvio (0 e 0 desliga)
CLIP_BEFORE=5
CLIP_AFTER=5
# Coleta de imagens para treinar o modelo com as câmeras do cliente (vazio = desligado)
# DATASET_DIR=C:\vigia-treino\coleta
# DATASET_INTERVAL=60
IMG_SIZE=640
# DEVICE=0
# LABEL_MAP={"capacete_ok": "helmet", "sem_capacete": "no_helmet"}

# ---------- E-mail (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
ALERT_EMAILS=

# ---------- WhatsApp Business Cloud API (Meta) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Números com DDI e DDD, sem "+", separados por vírgula (ex.: 5511999999999)
WHATSAPP_TO=
# Nome do template aprovado (recomendado; obrigatório fora da janela de 24h)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR

# Endereço do painel. Use HOST=0.0.0.0 para acessar de outros computadores da rede.
# HOST=127.0.0.1
# PORT=8000
