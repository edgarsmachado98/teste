# Copie para .env e preencha os tokens que tiver. Nenhum é obrigatório.

# Ordem em que as fontes de cotação são consultadas (a primeira que responder é usada).
CARTEIRA_FONTES=brapi,dadosdemercado,yahoo,hgbrasil

# brapi.dev: ações, FIIs, ETFs e BDRs da B3. Sem token, só PETR4, VALE3, MGLU3 e ITUB4.
# Crie em https://brapi.dev/dashboard
BRAPI_TOKEN=

# Dados de Mercado: https://www.dadosdemercado.com.br/api/docs
DADOSDEMERCADO_TOKEN=

# HG Brasil (só cotação atual, com atraso): https://hgbrasil.com
HGBRASIL_KEY=

# 1 = usa cotações simuladas (sem internet)
CARTEIRA_DEMO=

# Cópia de segurança diária do banco (padrão: pasta "backups" ao lado do banco).
# Aponte para uma pasta sincronizada para ter cópia fora do computador, ex.:
# CARTEIRA_BACKUP_DIR=C:\Users\SeuUsuario\OneDrive\Carteira
CARTEIRA_BACKUP_DIR=
# Quantas cópias diárias manter (padrão 30). CARTEIRA_BACKUP=0 desliga a cópia automática.
CARTEIRA_BACKUP_DIAS=30

# Endereço do arquivo de preços do Tesouro Direto (só mude se o Tesouro Transparente trocar o link).
TESOURO_CSV_URL=

# Alertas por Telegram (opcional): token do bot (@BotFather) e id da conversa/grupo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Limites dos alertas (padrões: 20% por ativo, 35% por setor, 5 pontos de desvio da meta).
CARTEIRA_LIMITE_ATIVO=20
CARTEIRA_LIMITE_SETOR=35
CARTEIRA_LIMITE_DESVIO=5

# Cotações durante o pregão (10h às 18h, dias úteis): validade em minutos (padrão 15).
CARTEIRA_INTERVALO_COTACOES=15
# Atualização automática das cotações em segundo plano com o servidor no ar (0 desliga).
CARTEIRA_ATUALIZACAO_AUTOMATICA=1

# Módulos adicionais (vendidos à parte da licença). Na fase de testes ficam todos liberados
# quando esta linha está vazia. Para desligar: CARTEIRA_MODULOS=nenhum
CARTEIRA_MODULOS=
